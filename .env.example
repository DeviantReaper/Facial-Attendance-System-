# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="FaceAttend — Attendance Portal"
INSTITUTION_NAME="Manipal University Jaipur"
ACADEMIC_YEAR="2025-26"

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, for local dev)
DATABASE_URL=sqlite:///./facial_attendance.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql://faceattend_user:strongpassword@localhost:5432/faceattend_db

# ─── JWT Security ─────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRE_MINUTES=1440

# ─── ML Models ────────────────────────────────────────────────────────────────
# Options: Facenet512, VGG-Face, ArcFace, DeepFace
RECOGNITION_MODEL=Facenet512
DETECTION_MODEL=yolov8n.pt
FACE_MODEL_DIR=./frontend/public/models

# ─── Recognition Thresholds ───────────────────────────────────────────────────
DETECTION_THRESHOLD=0.5
RECOGNITION_THRESHOLD=0.40
ATTENDANCE_CONFIDENCE_THRESHOLD=0.75
QUALITY_BLUR_THRESHOLD=80.0
QUALITY_MIN_BRIGHTNESS=50.0
QUALITY_MAX_BRIGHTNESS=220.0

# ─── Attendance Rules ─────────────────────────────────────────────────────────
ATTENDANCE_COOLDOWN_MINUTES=5

# ─── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
EMAILS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@faceattend.edu

# ─── CORS ─────────────────────────────────────────────────────────────────────
# For production, replace * with actual frontend domain
CORS_ORIGINS=["*"]

# ─── Frontend (set in frontend/.env) ─────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
